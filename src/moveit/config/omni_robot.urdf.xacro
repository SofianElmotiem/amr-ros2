<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="omni_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import omni_robot urdf file -->
    <xacro:include filename="$(find robot_description)/robot/omni_robot.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="omni_robot.ros2_control.xacro" />


    <xacro:omni_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
