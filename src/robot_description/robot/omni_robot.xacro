<?xml version="1.0"?>
<robot name="omni_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find robot_description)/urdf/inertial_macros.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/base/base.urdf.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/wheels/diff_wheels.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/lidar/lidar.urdf.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/camera/camera.urdf.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/ros2_control.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/shoulder/shoulder.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/upper_arm/upper_arm.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/elbow/elbow.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/lower_arm/lower_arm.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/wrist/wrist.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/gripper/gripper.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/finger/finger.xacro"/>
  <xacro:property name="PI" value="3.14159274"/>

  <!-- =============== Links & Joints =============== -->

  <link name="base_footprint"/>
  <xacro:base_v0 parent="base_footprint">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:base_v0>

  <!-- Differential drive wheels + caster -->
  <xacro:diff_wheels_v0/>

  <!-- LiDAR — rear-center, above base -->
  <xacro:lidar_v0 parent="base_link">
    <origin xyz="-0.04 0.04 0.06" rpy="0 0 0"/>
  </xacro:lidar_v0>

  <!-- RGBD Camera — above LiDAR, facing backward (away from arm) -->
  <xacro:camera_v0 parent="base_link">
    <origin xyz="-0.04 0.04 0.135" rpy="0 0 3.14159"/>
  </xacro:camera_v0>

  <!-- Arm -->
  <xacro:shoulder parent="base_link">
    <origin xyz="0.126 0 0.092" rpy="0 ${PI/2} 0"/>
    <axis xyz="0 0 1"/>
  </xacro:shoulder>

  <xacro:upper_arm parent="shoulder_link">
    <origin xyz="0.0 0.0 0.021" rpy="0 -${PI/2} 0"/>
    <axis xyz="0 1 0"/>
  </xacro:upper_arm>

  <xacro:elbow parent="upper_arm_link">
    <origin xyz="0.0 0.0 0.0685" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </xacro:elbow>

  <xacro:lower_arm parent="elbow_link">
    <origin xyz="0.0 0.0 0.078" rpy="0 -${5*PI/12} 0"/>
    <axis xyz="0 1 0"/>
  </xacro:lower_arm>

  <xacro:wrist parent="lower_arm_link">
    <origin xyz="0.0 0.0 0.083" rpy="0 -${7*PI/12} 0"/>
    <axis xyz="0 1 0"/>
  </xacro:wrist>

  <xacro:gripper parent="wrist_link">
    <origin xyz="0.0 0.0 0.122" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </xacro:gripper>

  <xacro:finger parent="gripper_link">
    <origin xyz="0.0 0.01475 -0.037" rpy="${-PI/6} 0 0"/>
    <axis xyz="1 0 0"/>
  </xacro:finger>

</robot>
