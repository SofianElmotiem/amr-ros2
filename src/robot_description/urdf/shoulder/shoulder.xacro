<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
  <xacro:macro name="shoulder" params="parent *joint_origin *joint_axis">
	<joint name="soulder_joint" type="revolute">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="shoulder_link"/>
          <limit effort="100" velocity="100" lower="-3.14" upper = "3.14"/>
          <dynamics damping="10.0" friction="1.0"/>
	  <xacro:insert_block name="joint_axis"/>
	</joint>

	<link name="shoulder_link">
	  <visual>
		  <geometry>
		    <mesh filename="package://robot_description/meshes/STL/shoulder/shoulder.stl"/>
		  </geometry>
	  </visual>
	  <collision>
		  <geometry>
		    <mesh filename="package://robot_description/meshes/STL/shoulder/shoulder.stl"/>
		  </geometry>
	  </collision>
	  <inertial>
		<origin xyz="0.0000223482 0.0000414609 0.0066287000"/>
		<mass value="0.05"/>
		<inertia ixx="0.000222" ixy="0" ixz="0" iyy="0.000395" iyz="0" izz="0.000222"/>
	  </inertial>
          <surface>
            <friction>
              <ode>
                <mu1>1.2</mu1>
                <mu2>1.2</mu2>
                <kp>1e15</kp>
                <kd>1e13</kd>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.01</restitution_coefficient>
              <threshold>0</threshold>
            </bounce>
            <contact>
              <ode>
                <max_vel>10</max_vel>
              </ode>
            </contact>
          </surface>
	</link>
  </xacro:macro>
  
</robot>
