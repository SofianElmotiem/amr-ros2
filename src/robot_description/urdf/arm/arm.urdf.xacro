<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find robot_description)/urdf/arm/arm.gazebo.xacro"/>
  
  <xacro:macro name="arm_v0" params="prefix parent *joint_origin *joint_axis">
	<joint name="${prefix}_arm_joint" type="revolute">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="${prefix}_arm_link"/>
          <limit effort="10" velocity="2" lower="-3.14159" upper = "3.14159"/>
          <dynamics damping="0.005" friction="0.1"/>
	  <xacro:insert_block name="joint_axis"/>
	</joint>

	<link name="${prefix}_arm_link">
	  <visual>
		  <geometry>
		    <mesh filename="package://robot_description/meshes/STL/arm/arm.stl"/>
		  </geometry>
	  </visual>
	  <collision>
		  <geometry>
		    <mesh filename="package://robot_description/meshes/STL/arm/arm.stl"/>
		  </geometry>
	  </collision>
	  <inertial>
		  <origin xyz="-0.1068 0.0 0.0"/>
		  <mass value="0.18"/>
		  <inertia ixx="0.0000518" ixy="0" ixz="0" iyy="0.000294" iyz="0" izz="0.00032"/>
	  </inertial>
	</link>

  </xacro:macro>
</robot>
