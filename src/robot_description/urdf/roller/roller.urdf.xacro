<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find robot_description)/urdf/roller/roller.gazebo.xacro"/>
  
  <xacro:macro name="roller_v0" params="prefix parent *joint_origin *joint_axis">
	<joint name="${prefix}_roller_joint" type="continuous">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="${prefix}_roller_link"/>
	  <xacro:insert_block name="joint_axis"/>
	</joint>

	<link name="${prefix}_roller_link">
	  <visual>
		<geometry>
		  <sphere radius="0.006"/>
		</geometry>
	  </visual>
	  <!-- No collision: planar_move handles locomotion, roller contacts waste CPU -->
	  <inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="0.001"/>
		<inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/>
	  </inertial>
	</link>
  </xacro:macro>
  
</robot>
