<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Differential drive: 2 driven wheels + 2 casters
       All 4 placed at the same corner positions as the original omni wheels -->
  <xacro:macro name="diff_wheels_v0">

    <!-- Left drive wheel — at the left-centre position (y=+0.086338) -->
    <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_wheel_link"/>
      <origin xyz="0.0 0.086338 -0.022" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="left_wheel_link">
      <visual>
        <geometry><cylinder radius="0.028" length="0.025"/></geometry>
        <material name="wheel_dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.028" length="0.025"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.1" length="0.025" radius="0.028">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <!-- Right drive wheel — at the right-centre position (y=-0.086338) -->
    <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_wheel_link"/>
      <origin xyz="0.0 -0.086338 -0.022" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="right_wheel_link">
      <visual>
        <geometry><cylinder radius="0.028" length="0.025"/></geometry>
        <material name="wheel_dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.028" length="0.025"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.1" length="0.025" radius="0.028">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <!-- Front caster — at the front-centre position (x=+0.086338) -->
    <joint name="front_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="front_caster_link"/>
      <origin xyz="0.086338 0.0 -0.030" rpy="0 0 0"/>
    </joint>
    <link name="front_caster_link">
      <visual>
        <geometry><sphere radius="0.020"/></geometry>
        <material name="caster_grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="0.020"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.000004" ixy="0" ixz="0"
                 iyy="0.000004" iyz="0"
                 izz="0.000004"/>
      </inertial>
    </link>

    <!-- Rear caster — at the rear-centre position (x=-0.086338) -->
    <joint name="rear_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="rear_caster_link"/>
      <origin xyz="-0.086338 0.0 -0.030" rpy="0 0 0"/>
    </joint>
    <link name="rear_caster_link">
      <visual>
        <geometry><sphere radius="0.020"/></geometry>
        <material name="caster_grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="0.020"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.000004" ixy="0" ixz="0"
                 iyy="0.000004" iyz="0"
                 izz="0.000004"/>
      </inertial>
    </link>

    <!-- Gazebo friction properties -->
    <gazebo reference="left_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="front_caster_link">
      <material>Gazebo/Grey</material>
      <mu1>0.001</mu1><mu2>0.001</mu2>
    </gazebo>
    <gazebo reference="rear_caster_link">
      <material>Gazebo/Grey</material>
      <mu1>0.001</mu1><mu2>0.001</mu2>
    </gazebo>

    <!-- Differential drive plugin -->
    <gazebo>
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <remapping>cmd_vel:=cmd_vel_out</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.172676</wheel_separation>
        <wheel_diameter>0.056</wheel_diameter>
        <max_wheel_torque>200</max_wheel_torque>
        <max_wheel_acceleration>10.0</max_wheel_acceleration>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <command_timeout>0.3</command_timeout>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
