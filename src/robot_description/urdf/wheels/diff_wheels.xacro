<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Differential drive wheels + caster + Gazebo diff_drive plugin -->
  <xacro:macro name="diff_wheels_v0">

    <!-- Left drive wheel -->
    <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_wheel_link"/>
      <origin xyz="0.0 0.175 0.0" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="left_wheel_link">
      <visual>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        <material name="wheel_dark"><color rgba="0.15 0.15 0.15 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.2" length="0.04" radius="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <!-- Right drive wheel -->
    <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_wheel_link"/>
      <origin xyz="0.0 -0.175 0.0" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="right_wheel_link">
      <visual>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        <material name="wheel_dark"><color rgba="0.15 0.15 0.15 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.2" length="0.04" radius="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <!-- Rear caster wheel (arm is at the front, caster at back) -->
    <joint name="caster_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_wheel_link"/>
      <origin xyz="-0.1 0.0 -0.025" rpy="0 0 0"/>
    </joint>
    <link name="caster_wheel_link">
      <visual>
        <geometry><sphere radius="0.025"/></geometry>
        <material name="caster_grey"><color rgba="0.7 0.7 0.7 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="0.025"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.000013" ixy="0" ixz="0"
                 iyy="0.000013" iyz="0"
                 izz="0.000013"/>
      </inertial>
    </link>

    <!-- Wheel friction properties -->
    <gazebo reference="left_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <!-- Caster is frictionless so it swivels freely -->
    <gazebo reference="caster_wheel_link">
      <material>Gazebo/Grey</material>
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
    </gazebo>

    <!-- Differential drive Gazebo plugin -->
    <gazebo>
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <remapping>cmd_vel:=cmd_vel_out</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.35</wheel_separation>
        <wheel_diameter>0.1</wheel_diameter>
        <max_wheel_torque>200</max_wheel_torque>
        <max_wheel_acceleration>10.0</max_wheel_acceleration>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
