<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- RealSense D435i with Stereo IR -->
    <joint name="camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <origin xyz="0.505 -0.15 0.68" rpy="0 0.0 0"/>
    </joint>

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.025 0.09 0.025"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.025 0.09 0.025"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.072"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <!-- RGB Camera Optical Frame -->
    <joint name="camera_rgb_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_rgb_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_rgb_optical_frame"/>

    <!-- Depth Camera Optical Frame -->
    <joint name="camera_depth_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_depth_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_depth_optical_frame"/>

    <!-- Left IR Camera Frame -->
    <joint name="camera_left_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_left_frame"/>
        <origin xyz="0 0.0175 0" rpy="0 0 0"/>
    </joint>

    <link name="camera_left_frame"/>

    <joint name="camera_left_optical_joint" type="fixed">
        <parent link="camera_left_frame"/>
        <child link="camera_left_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_left_optical_frame"/>

    <!-- Right IR Camera Frame -->
    <joint name="camera_right_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_right_frame"/>
        <origin xyz="0 -0.0175 0" rpy="0 0 0"/>
    </joint>

    <link name="camera_right_frame"/>

    <joint name="camera_right_optical_joint" type="fixed">
        <parent link="camera_right_frame"/>
        <child link="camera_right_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_right_optical_frame"/>

    <!-- Gazebo RGB-D Camera Plugin -->
    <gazebo reference="camera_link">
        <material>Gazebo/White</material>
        <sensor name="rgbd_camera" type="depth">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.5184</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.3</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>camera_depth_optical_frame</frame_name>
                <min_depth>0.3</min_depth>
                <max_depth>10.0</max_depth>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Gazebo Left IR Camera -->
    <gazebo reference="camera_left_frame">
        <sensor name="left_ir_camera" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>false</visualize>
            <camera name="left_camera">
                <horizontal_fov>1.5184</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>L8</format>
                </image>
                <clip>
                    <near>0.3</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <plugin name="left_camera_controller" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>left_camera</namespace>
                    <remapping>~/image_raw:=image_raw</remapping>
                    <remapping>~/camera_info:=camera_info</remapping>
                </ros>
                <camera_name>left_camera</camera_name>
                <frame_name>camera_left_optical_frame</frame_name>
                <hack_baseline>0.07</hack_baseline>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Gazebo Right IR Camera -->
    <gazebo reference="camera_right_frame">
        <sensor name="right_ir_camera" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>false</visualize>
            <camera name="right_camera">
                <horizontal_fov>1.5184</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>L8</format>
                </image>
                <clip>
                    <near>0.3</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <plugin name="right_camera_controller" filename="libgazebo_ros_depth_camera.so">
                <ros>
                    <namespace>right_camera</namespace>
                    <remapping>~/image_raw:=image_raw</remapping>
                    <remapping>~/camera_info:=camera_info</remapping>
                </ros>
                <camera_name>right_camera</camera_name>
                <frame_name>camera_right_optical_frame</frame_name>
                <hack_baseline>0.07</hack_baseline>
            </plugin>
        </sensor>
    </gazebo>

</robot>
