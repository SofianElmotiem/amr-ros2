<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
  <xacro:macro name="finger" params=" parent *joint_origin *joint_axis">
	<joint name="finger_joint" type="revolute">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="finger_link"/>
          <limit effort="100" velocity="100" lower="-1.57" upper = "1.57"/>
          <dynamics damping="5.0" friction="0.5"/>
	  <xacro:insert_block name="joint_axis"/>
	</joint>

	<link name="finger_link">
	  <visual>
		  <geometry>
		    <mesh filename="package://robot_description/meshes/STL/finger/finger.stl"/>
		  </geometry>
	  </visual>
	  <collision>
		  <geometry>
		    <mesh filename="package://robot_description/meshes/STL/finger/finger.stl"/>
		  </geometry>
	  </collision>
	  <inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="0.01"/>
		<inertia ixx="0.000004731" ixy="-0.000000456" ixz="0.0" iyy="0.000003500" iyz="0.0" izz="0.000003747"/>
	  </inertial>
          <surface>
            <friction>
              <ode>
                <mu1>1.2</mu1>
                <mu2>1.2</mu2>
                <kp>1e15</kp>
                <kd>1e13</kd>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.01</restitution_coefficient>
              <threshold>0</threshold>
            </bounce>
            <contact>
              <ode>
                <max_vel>10</max_vel>
              </ode>
            </contact>
          </surface>
	</link>
  </xacro:macro>
  
</robot>
